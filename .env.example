# Backend
PORT=3000
# MongoDB Atlas (free tier) — replace with your cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/booking_challenge?retryWrites=true&w=majority
NODE_ENV=development
# Temporary slot lock duration (seconds)
SLOT_LOCK_TTL_SECONDS=60

# Frontend (Angular proxy targets the backend; override only if needed)
API_BASE_URL=http://localhost:3000/api
